# Official generic builds contain no server, key or embedded credentials.
# Sign in to your self-hosted service; signal configuration is retrieved after authentication.
[brand]
app_name = "NestLink"
executable_name = "homedesk"
package_name = "homedesk"
config_namespace = "HomeDesk"

[server]
host = ""
relay_host = ""
key = ""

[net]
mode = "self_hosted"
whitelist_cidr = ""
source_cidr = ""

[console]
enabled = false
trusted_path = false
