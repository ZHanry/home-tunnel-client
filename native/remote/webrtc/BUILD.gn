import("//webrtc.gni")
if (is_linux) {
  import("//build/config/linux/pkg_config.gni")
  pkg_config("home_tunnel_x11") {
    packages = [ "x11", "xtst", "xrandr", "libsystemd" ]
  }
}

# Explicit local integration probe. It is not linked into the public C ABI and
# never accepts remote signaling or grants from another process.
rtc_executable("home_tunnel_webrtc_probe") {
  sources = [ "media_probe.cpp" ]
  deps = [
    "//api:create_peerconnection_factory",
    "//api/audio_codecs:builtin_audio_decoder_factory",
    "//api/audio_codecs:builtin_audio_encoder_factory",
    "//api/video:video_broadcaster",
    "//api/video_codecs:builtin_video_decoder_factory",
    "//api/video_codecs:builtin_video_encoder_factory",
    "//modules/desktop_capture:desktop_capture",
    "//modules/audio_device:audio_device_default",
    "//pc:video_track_source",
    "//rtc_base:logging",
    "//rtc_base:ssl_adapter",
    "//rtc_base:threading",
    "//rtc_base:timeutils",
    "//third_party/libyuv",
    "//third_party/jsoncpp",
  ]
  if (is_win) {
    deps += [ "//rtc_base:win32_socket_init" ]
    libs = [ "ole32.lib" ]
  }
}

if (is_win) {
  rtc_executable("home_tunnel_input_guard_tests") {
    sources = [ "../tests/windows_input_guard_tests.cpp", "../src/platform/windows_input.cpp" ]
    deps = []
    libs = [ "user32.lib" ]
  }
}
template("home_tunnel_host") {
  x11_testing = invoker.testing
  rtc_executable(target_name) {
    sources = [
      "host_worker.cpp",
      "host_platform.cpp",
      "authorization.cpp",
      "peer_identity.cpp",
      "clipboard.cpp",
      "file_transfer.cpp",
      "file_transfer_storage.cpp",
      "../src/protocol.cpp",
      "../src/session_gate.cpp",
    ]
    deps = [
      "//api:create_peerconnection_factory",
      "//api/audio_codecs:builtin_audio_decoder_factory",
      "//api/audio_codecs:builtin_audio_encoder_factory",
      "//api/video:video_broadcaster",
      "//api/video_codecs:builtin_video_decoder_factory",
      "//api/video_codecs:builtin_video_encoder_factory",
      "//modules/desktop_capture:desktop_capture",
      "//modules/audio_device:audio_device_default",
      "//pc:video_track_source",
      "//rtc_base:logging",
      "//rtc_base:ssl",
      "//rtc_base:ssl_adapter",
      "//rtc_base:threading",
      "//rtc_base:timeutils",
      "//third_party/boringssl",
      "//third_party/jsoncpp",
      "//third_party/libyuv",
    ]
    if (is_win) {
      sources += [ "clipboard_windows.cpp", "../src/platform/windows_input.cpp" ]
      deps += [ "//rtc_base:win32_socket_init" ]
      libs = [ "ole32.lib", "user32.lib", "bcrypt.lib" ]
    } else {
      sources += [ "../src/platform/x11_input.cpp", "../src/platform/x11_session.cpp" ]
      configs += [ ":home_tunnel_x11" ]
    }
    if (x11_testing) {
      defines = [ "HT_RD_X11_TESTING" ]
    }
  }
}
if (is_win || is_linux) {
  home_tunnel_host("home_tunnel_remote_host") {
    testing = false
  }
}
if (is_linux) {
  # Separate, non-distributable CI binary. The production host never compiles
  # the test-only Xvfb session allowance.
  home_tunnel_host("home_tunnel_remote_host_xvfb") {
    testing = true
  }
  rtc_executable("home_tunnel_x11_input_tests") {
    sources = [ "../tests/x11_input_tests.cpp", "../src/platform/x11_input.cpp", "../src/platform/x11_session.cpp" ]
    deps = []
    defines = [ "HT_RD_X11_TESTING" ]
    configs += [ ":home_tunnel_x11" ]
  }
}

rtc_executable("home_tunnel_authorization_tests") {
  sources = [
    "../android/controller_identity.cpp",
    "authorization.cpp",
    "authorization.hpp",
    "authorization_tests.cpp",
    "peer_identity.cpp",
    "peer_identity.hpp",
    "../src/protocol.cpp",
  ]
  deps = [
    "//third_party/boringssl",
    "//third_party/jsoncpp",
    "//rtc_base:ssl",
  ]
}

rtc_executable("home_tunnel_clipboard_tests") {
  sources = [
    "clipboard_tests.cpp",
    "clipboard.cpp",
    "authorization.cpp",
    "peer_identity.cpp",
    "../src/protocol.cpp",
  ]
  deps = [ "//third_party/boringssl", "//third_party/jsoncpp", "//rtc_base:ssl" ]
}

rtc_executable("home_tunnel_file_transfer_tests") {
  sources = [ "file_transfer_tests.cpp", "file_transfer.cpp", "file_transfer_storage.cpp", "../src/protocol.cpp" ]
  deps = [ "//third_party/boringssl", "//third_party/jsoncpp" ]
  if (is_win) {
    libs = [ "bcrypt.lib" ]
  }
}
