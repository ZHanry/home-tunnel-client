import("//webrtc.gni")

assert(is_android && current_cpu == "arm64")

group("default") {
  deps = [
    ":home_tunnel_android_controller",
    ":home_tunnel_android_surface",
    "//:webrtc",
  ]
}

config("controller_exports") {
  ldflags = [
    "-Wl,--version-script=" + rebase_path("controller.exports", root_build_dir),
    "-Wl,--exclude-libs=ALL",
    "-Wl,-z,max-page-size=16384",
  ]
}

rtc_shared_library("home_tunnel_android_controller") {
  output_name = "home_tunnel_remote"
  sources = [
    "../src/protocol.cpp",
    "../webrtc/authorization.cpp",
    "../webrtc/peer_identity.cpp",
    "controller_identity.cpp",
    "controller_runtime.cpp",
  ]
  defines = [
    "HT_RD_BUILD",
    "HT_RD_SHARED",
  ]
  configs += [ ":controller_exports" ]
  deps = [
    ":home_tunnel_android_surface",
    "//api:create_peerconnection_factory",
    "//api/audio_codecs:builtin_audio_decoder_factory",
    "//api/audio_codecs:builtin_audio_encoder_factory",
    "//api/video_codecs:builtin_video_decoder_factory",
    "//api/video_codecs:builtin_video_encoder_factory",
    "//rtc_base:logging",
    "//rtc_base:ssl",
    "//rtc_base:ssl_adapter",
    "//rtc_base:threading",
    "//rtc_base:timeutils",
    "//third_party/boringssl",
    "//third_party/jsoncpp",
  ]
  libs = [ "android" ]
}

# Compiled with the exact same headers/toolchain/stdlib as WebRTC. This archive
# is an internal controller building block, not a separately loadable app ABI.
rtc_static_library("home_tunnel_android_surface") {
  sources = [
    "surface_renderer.cpp",
    "surface_renderer.hpp",
  ]
  deps = [
    "//api/video:video_frame",
    "//third_party/libyuv",
  ]
  libs = [ "android" ]
}
